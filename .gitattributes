# Default git behavior
* text=auto

### OVERRIDES ###

# CRLF => LF
.prettierrc      text  eol=lf
.prettierignore  text  eol=lf
*.txt            text  eol=lf
*.md             text  eol=lf
*.gitattributes  text  eol=lf
*.gitmodules     text  eol=lf
*.gitignore      text  eol=lf
*.yml            text  eol=lf
*.json           text  eol=lf
*.ps1            text  eol=lf
**/LICENSE       text  eol=lf
**/CODEOWNERS    text  eol=lf
*.html           text  eol=lf
*.pom            text  eol=lf
*.xml            text  eol=lf
*.md5            text  eol=lf
*.sha1           text  eol=lf

# LF/CRLF => BINARY
*.jar            binary
*.icns           binary
*.jar            binary
*.aar            binary

### Gradle
**/*.gradle      text eol=lf
**/gradlew       text eol=lf
*.bat            text eol=crlf

### Java / Kotlin
**/*.java        text eol=lf
**/*.kt          text eol=lf
